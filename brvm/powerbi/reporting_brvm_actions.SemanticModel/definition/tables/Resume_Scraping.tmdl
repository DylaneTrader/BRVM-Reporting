		summarizeBy: none
		sourceColumn: Dernier_Cours

	partition Resume_Scraping = m
		mode: import
		source =
				let
				    CheminDonnees = DossierDonnees,
				    Source = Csv.Document(File.Contents(CheminDonnees & "\resume_scraping.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    TypesDates = Table.TransformColumnTypes(EnTetes, {{"Date_Min", type date}, {"Date_Max", type date}}, "en-US"),
				    Types = Table.TransformColumnTypes(TypesDates, {{"Ticker", type text}, {"Type", type text}, {"Nb_Lignes", Int64.Type}, {"Dernier_Cours", type number}}, "fr-FR")
				in
				    Types

	annotation PBI_ResultType = Table

