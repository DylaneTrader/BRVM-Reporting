	partition Dim_Action = m
		mode: import
		source =
				let
				    NettoyerNombre = (t as nullable text) as nullable number =>
				        let
				            brut = if t = null then null else Text.Trim(t),
				            sansUnites = if brut = null then null else Text.Replace(Text.Replace(Text.Replace(Text.Replace(brut, "MFCFA", ""), "FCFA", ""), "%", ""), "×", ""),
				            sansEspaces = if sansUnites = null then null else Text.Replace(Text.Replace(sansUnites, "#(00A0)", ""), " ", ""),
				            resultat = if sansEspaces = null or sansEspaces = "" or sansEspaces = "N/A" or sansEspaces = "-" then null else try Number.FromText(Text.Replace(sansEspaces, ",", "."), "en-US") otherwise null
				        in
				            resultat,
				    CheminDonnees = DossierDonnees,
				    Source = Folder.Files(CheminDonnees & "\societes"),
				    FichiersJson = Table.SelectRows(Source, each Text.EndsWith([Name], "_societe.json")),
				    AjoutRecord = Table.AddColumn(FichiersJson, "R", each Json.Document([Content], 65001)),
				    Lignes = Table.SelectColumns(AjoutRecord, {"R"}),
				    Construit = Table.AddColumn(Lignes, "Ligne", each
				        let r = [R] in
				        [
				            Symbol = Record.FieldOrDefault(r, "ticker", null),
				            Name = Record.FieldOrDefault(r, "Nom", null),
				            Secteur = Record.FieldOrDefault(r, "Secteur", null),
				            SecteurCourt = let s = Record.FieldOrDefault(r, "Secteur", null) in if s = null then null else Text.Trim(Text.Replace(s, "BRVM - ", "")),
				            ISIN = Record.FieldOrDefault(r, "ISIN", null),
				            NombreTitres = NettoyerNombre(Record.FieldOrDefault(r, "Nombre_Titres", Record.FieldOrDefault(r, "Nombre de titres", null))),
				            PER = NettoyerNombre(Record.FieldOrDefault(r, "PER", null)),
				            Dividende = NettoyerNombre(Record.FieldOrDefault(r, "Dividende", null)),
				            BNPA = NettoyerNombre(Record.FieldOrDefault(r, "BNPA", null)),
				            ChiffreAffaires = NettoyerNombre(Record.FieldOrDefault(r, "Chiffre d'affaires", null)),
				            ResultatNet = NettoyerNombre(Record.FieldOrDefault(r, "Résultat net", null)),
				            ValorisationMFCFA = NettoyerNombre(Record.FieldOrDefault(r, "Valorisation", Record.FieldOrDefault(r, "Valorisation de la société", null))),
				            FlottantPct = NettoyerNombre(Record.FieldOrDefault(r, "Flottant_Pct", Record.FieldOrDefault(r, "Flottant", null))),
				            Description = Record.FieldOrDefault(r, "La société", null),
				            Dirigeants = Record.FieldOrDefault(r, "Dirigeants", null),
				            Adresse = Record.FieldOrDefault(r, "Adresse", null),
				            Telephone = Record.FieldOrDefault(r, "Téléphone", null)
				        ]),
				    Etendu = Table.ExpandRecordColumn(Table.SelectColumns(Construit, {"Ligne"}), "Ligne", {"Symbol", "Name", "Secteur", "SecteurCourt", "ISIN", "NombreTitres", "PER", "Dividende", "BNPA", "ChiffreAffaires", "ResultatNet", "ValorisationMFCFA", "FlottantPct", "Description", "Dirigeants", "Adresse", "Telephone"}),
				    Types = Table.TransformColumnTypes(Etendu, {{"Symbol", type text}, {"Name", type text}, {"Secteur", type text}, {"SecteurCourt", type text}, {"ISIN", type text}, {"NombreTitres", type number}, {"PER", type number}, {"Dividende", type number}, {"BNPA", type number}, {"ChiffreAffaires", type number}, {"ResultatNet", type number}, {"ValorisationMFCFA", type number}, {"FlottantPct", type number}, {"Description", type text}, {"Dirigeants", type text}, {"Adresse", type text}, {"Telephone", type text}})
				in
				    Types

	annotation PBI_ResultType = Table

