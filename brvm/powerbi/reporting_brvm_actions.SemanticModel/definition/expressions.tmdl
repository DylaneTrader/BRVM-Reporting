/// Dossier data/ d'un clone de DylaneTrader/Scraper-BRVM (ou d'un dossier de même structure).
/// À renseigner dans Power BI : Transformer les données → Gérer les paramètres → DossierDonnees.
expression DossierDonnees = "C:\Scraper-BRVM\data" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: e2000000-0000-0000-0000-000000000001

	annotation PBI_ResultType = Text

