    "#E4572E",
    "#6C5CE7",
    "#7A8CA3",
    "#1B2A4A",
    "#8FC7F2",
    "#0E7C6B",
    "#C0392B",
    "#2E86C1"
  ],
  "foreground": "#1B2A4A",
  "foregroundNeutralSecondary": "#5A6B87",
  "foregroundNeutralTertiary": "#AEB8CC",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F6FA",
  "backgroundNeutral": "#E6EBF2",
  "tableAccent": "#0B5CAB",
  "good": "#12B5A6",
  "neutral": "#F2A93B",
  "bad": "#E4572E",
  "maximum": "#0B5CAB",
  "center": "#8FC7F2",
  "minimum": "#EAF3FC",
  "hyperlink": "#0B5CAB",
  "textClasses": {
    "callout": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 30,
      "color": "#0B2A5B"
    },
    "title": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 13,
      "color": "#0B2A5B"
    },
    "header": {
      "fontFace": "Segoe UI Semibold",
      "fontSize": 12,
      "color": "#1B2A4A"
    },
    "label": {
      "fontFace": "Segoe UI",
      "fontSize": 10,
      "color": "#5A6B87"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E6EBF2"
              }
            },
            "radius": 12
          }
        ],
        "dropShadow": [
          {
            "show": true,
            "preset": "BottomRight"
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "transparency": 100,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "foreground": {
              "solid": {
                "color": "#AEB8CC"
              }
            }
          }
        ],
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#0B2A5B"
              }
            },
            "alignment": "left",
            "fontSize": 12,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#0B2A5B"
              }
            },
            "fontSize": 26,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "color": {
              "solid": {
                "color": "#5A6B87"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "cardVisual": {
      "*": {
        "calloutValue": [
          {
            "fontColor": {
              "solid": {
                "color": "#0B2A5B"
              }
            },
            "fontFamily": "Segoe UI Semibold"
          }
        ]
      }
    }
  }
}