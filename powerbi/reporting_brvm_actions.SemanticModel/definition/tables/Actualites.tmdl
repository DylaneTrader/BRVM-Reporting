	partition Actualites = m
		mode: import
		source =
				let
				    CheminDonnees = "c:\Users\DYLANE\OneDrive - CGF BOURSE\Bureau\MES MINI-APPS\BRVM app\data",
				    Source = Csv.Document(File.Contents(CheminDonnees & "\news\actualites_brvm.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    DatePub = Table.AddColumn(EnTetes, "DatePublication", each try Date.From(DateTimeZone.From([date_publication])) otherwise (try Date.From([date_publication], "fr-FR") otherwise null), type date),
				    DateScrap = Table.AddColumn(DatePub, "DateScraping", each try DateTime.From(DateTimeZone.From([date_scraping])) otherwise (try DateTime.From([date_scraping], "fr-FR") otherwise null), type datetime),
				    Extrait = Table.AddColumn(DateScrap, "Extrait", each if [contenu] = null then null else Text.Start(Text.Trim([contenu]), 220) & (if Text.Length(Text.Trim([contenu])) > 220 then "…" else ""), type text),
				    Selection = Table.SelectColumns(Extrait, {"id", "titre", "DatePublication", "auteur", "categorie", "contenu", "Extrait", "image_url", "url", "DateScraping"}),
				    Types = Table.TransformColumnTypes(Selection, {{"id", type text}, {"titre", type text}, {"auteur", type text}, {"categorie", type text}, {"contenu", type text}, {"image_url", type text}, {"url", type text}})
				in
				    Types

	annotation PBI_ResultType = Table

