	column EstDébutMois
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 76ad27f6-1393-4877-9c4a-2ac1266806d4
		summarizeBy: none
		isNameInferred
		sourceColumn: [EstDébutMois]

	column EstDébutTrimestre
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: 252a08e3-32ea-49bd-a05a-12bf18f5f9d3
		summarizeBy: none
		isNameInferred
		sourceColumn: [EstDébutTrimestre]

	column EstDébutAnnée
		dataType: boolean
		formatString: """TRUE"";""TRUE"";""FALSE"""
		lineageTag: a160207c-e7e9-476d-847b-33087ab55e35
		summarizeBy: none
		isNameInferred
		sourceColumn: [EstDébutAnnée]

	partition Dim_Date = calculated
		mode: import
		source =
				VAR MinD = MIN(MIN(Cotations_Actions[Date]), MIN(Cotations_Indices[Date]))
				VAR MaxD = MAX(MAX(Cotations_Actions[Date]), MAX(Cotations_Indices[Date]))
				RETURN
				ADDCOLUMNS(
				    CALENDAR(MinD, MaxD),
				    "Année", YEAR([Date]),
				    "NuméroMois", MONTH([Date]),
				    "Mois", FORMAT([Date], "mmmm", "fr-FR"),
				    "AnnéeMois", FORMAT([Date], "yyyy-mm"),
				    "Trimestre", "T" & FORMAT([Date], "q"),
				    "Semaine", WEEKNUM([Date], 21),
				    "JourSemaine", WEEKDAY([Date], 2),
				    "NomJour", FORMAT([Date], "dddd", "fr-FR"),
				    "EstDébutSemaine", WEEKDAY([Date], 2) = 1,
				    "EstDébutMois", DAY([Date]) = 1,
				    "EstDébutTrimestre", DAY([Date]) = 1 && MOD(MONTH([Date]) - 1, 3) = 0,
				    "EstDébutAnnée", DAY([Date]) = 1 && MONTH([Date]) = 1
				)

	annotation PBI_Id = DimDateBRVM

