		sourceColumn: VariationPct

	partition Cotations_Actions = m
		mode: import
		source =
				let
				    CheminDonnees = "c:\Users\DYLANE\OneDrive - CGF BOURSE\Bureau\MES MINI-APPS\BRVM app\data",
				    Source = Folder.Files(CheminDonnees & "\actions"),
				    FichiersHistorique = Table.SelectRows(Source, each Text.EndsWith([Name], "_historique.csv")),
				    AjoutSymbol = Table.AddColumn(FichiersHistorique, "Symbol", each Text.Replace(Text.BeforeDelimiter([Name], "_historique.csv"), "_", "."), type text),
				    AjoutData = Table.AddColumn(AjoutSymbol, "Data", each Table.PromoteHeaders(Csv.Document([Content], [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.None]), [PromoteAllScalars = true])),
				    Selection = Table.SelectColumns(AjoutData, {"Symbol", "Data"}),
				    Expansion = Table.ExpandTableColumn(Selection, "Data", {"Date", "Ouverture", "Plus_Haut", "Plus_Bas", "Cloture", "Volume_Titres", "Volume_FCFA", "Variation_Pct"}),
				    TypeDate = Table.TransformColumnTypes(Expansion, {{"Date", type date}}, "en-US"),
				    TypesNombres = Table.TransformColumnTypes(TypeDate, {{"Ouverture", type number}, {"Plus_Haut", type number}, {"Plus_Bas", type number}, {"Cloture", type number}, {"Volume_Titres", Int64.Type}, {"Volume_FCFA", type number}, {"Variation_Pct", type number}}, "fr-FR"),
				    Renommage = Table.RenameColumns(TypesNombres, {{"Plus_Haut", "PlusHaut"}, {"Plus_Bas", "PlusBas"}, {"Volume_Titres", "VolumeTitres"}, {"Volume_FCFA", "VolumeFCFA"}, {"Variation_Pct", "VariationPct"}}),
				    SansDateNulle = Table.SelectRows(Renommage, each [Date] <> null)
				in
				    SansDateNulle

	annotation PBI_ResultType = Table

