	partition Dividendes = m
		mode: import
		source =
				let
				    CheminDonnees = "c:\Users\DYLANE\OneDrive - CGF BOURSE\Bureau\MES MINI-APPS\BRVM app\data",
				    Source = Csv.Document(File.Contents(CheminDonnees & "\dividendes\dividendes.csv"), [Delimiter = ";", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    EnTetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    DateScrap = Table.TransformColumnTypes(EnTetes, {{"Date_Scraping", type date}}, "en-US"),
				    AjoutDetachement = Table.AddColumn(DateScrap, "DateDetachement", each try Date.From([Date_Detachement], "en-US") otherwise null, type date),
				    AjoutPaiement = Table.AddColumn(AjoutDetachement, "DatePaiement", each try Date.From([Date_Paiement], "en-US") otherwise null, type date),
				    TypesNombres = Table.TransformColumnTypes(AjoutPaiement, {{"Montant_Net_FCFA", type number}, {"Rendement_Pct", type number}}, "fr-FR"),
				    TypesTexte = Table.TransformColumnTypes(TypesNombres, {{"Ticker", type text}, {"Nom_Canonique", type text}, {"Exercice", type text}, {"Statut", type text}, {"Avis_URL", type text}, {"Sources", type text}}),
				    Selection = Table.SelectColumns(TypesTexte, {"Date_Scraping", "Ticker", "Nom_Canonique", "Exercice", "Statut", "DateDetachement", "DatePaiement", "Montant_Net_FCFA", "Rendement_Pct", "Avis_URL", "Sources"})
				in
				    Selection

	annotation PBI_ResultType = Table

