		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a509

	measure 'KYC PER' = SELECTEDVALUE(Dim_Action[PER])
		formatString: 0.00
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a510

	measure 'KYC Dividende (FCFA)' = SELECTEDVALUE(Dim_Action[Dividende])
		formatString: #,0.00
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a511

	measure 'KYC Flottant' = DIVIDE(SELECTEDVALUE(Dim_Action[FlottantPct]), 100)
		formatString: 0.00%
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a512

	measure 'KYC Nb Titres' = SELECTEDVALUE(Dim_Action[NombreTitres])
		formatString: #,0
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a513

	measure 'KYC BNPA' = SELECTEDVALUE(Dim_Action[BNPA])
		formatString: #,0.00
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a514

	measure 'KYC Chiffre Affaires (MFCFA)' = SELECTEDVALUE(Dim_Action[ChiffreAffaires])
		formatString: #,0
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a515

	measure 'KYC Résultat Net (MFCFA)' = SELECTEDVALUE(Dim_Action[ResultatNet])
		formatString: #,0
		displayFolder: KYC
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a516

	/// Chiffre d'affaires (MFCFA) issu des fondamentaux : axe = Fondamentaux[Annee]
	measure CA = CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "Chiffre d'affaires")
		formatString: #,0
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0001-4e8a-b7c5-fad0000000a1

	measure 'Résultat Net Fond' = CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "Résultat net")
		formatString: #,0
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0002-4e8a-b7c5-fad0000000a2

	measure 'BNPA Fond' = CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "BNPA")
		formatString: #,0.00
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0003-4e8a-b7c5-fad0000000a3

	measure 'PER Fond' = CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "PER")
		formatString: 0.00
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0004-4e8a-b7c5-fad0000000a4

	measure 'Dividende Fond' = CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "Dividende")
		formatString: #,0.00
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0005-4e8a-b7c5-fad0000000a5

	measure 'Croissance CA' = DIVIDE(CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "Croissance CA"), 100)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0006-4e8a-b7c5-fad0000000a6

	measure 'Croissance RN' = DIVIDE(CALCULATE(SUM(Fondamentaux[Valeur]), Fondamentaux[Indicateur] = "Croissance RN"), 100)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0007-4e8a-b7c5-fad0000000a7

	/// Marge nette = Résultat net / Chiffre d'affaires (par exercice)
	measure 'Marge Nette' = DIVIDE([Résultat Net Fond], [CA])
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0008-4e8a-b7c5-fad0000000a8

	/// Taux de distribution = Dividende / BNPA (par exercice)
	measure Payout = DIVIDE([Dividende Fond], [BNPA Fond])
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0009-4e8a-b7c5-fad0000000a9

	/// Dernier exercice fondamental connu dans le contexte société
	measure 'Dernier Exercice' = CALCULATE(MAX(Fondamentaux[Annee]), ALLEXCEPT(Fondamentaux, Dim_Action))
		formatString: 0
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0010-4e8a-b7c5-fad0000000b0

	measure 'CA (dernier ex.)' = CALCULATE([CA], Fondamentaux[Annee] = [Dernier Exercice])
		formatString: #,0
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0011-4e8a-b7c5-fad0000000b1

	measure 'RN (dernier ex.)' = CALCULATE([Résultat Net Fond], Fondamentaux[Annee] = [Dernier Exercice])
		formatString: #,0
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0012-4e8a-b7c5-fad0000000b2

	measure 'Marge Nette (dernier ex.)' = CALCULATE([Marge Nette], Fondamentaux[Annee] = [Dernier Exercice])
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0013-4e8a-b7c5-fad0000000b3

	measure 'Payout (dernier ex.)' = CALCULATE([Payout], Fondamentaux[Annee] = [Dernier Exercice])
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0014-4e8a-b7c5-fad0000000b4

	/// Marge nette actuelle (snapshot Dim_Action) : agrège correctement dans une table
	measure 'Marge Nette Actuelle' = DIVIDE(SUMX(VALUES(Dim_Action[Symbol]), Dim_Action[ResultatNet]), SUMX(VALUES(Dim_Action[Symbol]), Dim_Action[ChiffreAffaires]))
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0015-4e8a-b7c5-fad0000000b5

	/// Taux de distribution actuel (snapshot Dim_Action)
	measure 'Payout Actuel' = DIVIDE(SUMX(VALUES(Dim_Action[Symbol]), Dim_Action[Dividende]), SUMX(VALUES(Dim_Action[Symbol]), Dim_Action[BNPA]))
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0016-4e8a-b7c5-fad0000000b6

	/// Poids de la société dans la capitalisation totale du marché
	measure 'Poids Marché %' = DIVIDE([Capitalisation], CALCULATE([Capitalisation], ALL(Dim_Action)))
		formatString: 0.00%
		displayFolder: Fondamental
		lineageTag: 4a7b1c2d-0017-4e8a-b7c5-fad0000000b7

	column Col
		dataType: string
		isHidden
		lineageTag: 1cc619ea-60aa-4ec8-9c03-35a118fc340f
		summarizeBy: none
		sourceColumn: Col

	partition _Mesures = m
		mode: import
		source =
				let
				    Source = #table(type table [Col = text], {})
				in
				    Source

	annotation PBI_ResultType = Table

