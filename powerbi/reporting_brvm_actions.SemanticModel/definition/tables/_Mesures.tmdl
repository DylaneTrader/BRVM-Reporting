table _Mesures
	lineageTag: b970d31a-1336-4c89-949e-0fd2271752ae

	/// Cours de clôture moyen dans le contexte courant (une action / une date)
	measure 'Cours Clôture' = AVERAGE(Cotations_Actions[Cloture])
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 8ac22402-be3a-456c-8b89-b43a96f7b06b

	/// Dernier cours connu de l'action dans le contexte courant
	measure 'Dernier Cours' = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])))
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 4c8f6f88-1657-4e89-906b-6861b8989776

	measure 'Actions Suivies' = DISTINCTCOUNT(Cotations_Actions[Symbol])
		formatString: 0
		displayFolder: Marché
		lineageTag: 00df772f-54f0-49a7-a585-96294e8cf75c

	measure 'Indices Suivis' = DISTINCTCOUNT(Cotations_Indices[Symbol])
		formatString: 0
		displayFolder: Marché
		lineageTag: 9d583ddf-cecb-4c80-ad09-072beadb7a44

	measure 'Dernière Séance' = MAX(Cotations_Actions[Date])
		formatString: dd/mm/yyyy
		displayFolder: Marché
		lineageTag: b6823ae3-9394-41af-8a5f-cd7a7ff26960

	measure 'Première Séance' = MIN(Cotations_Actions[Date])
		formatString: dd/mm/yyyy
		displayFolder: Marché
		lineageTag: 8021f871-e902-408c-bfcd-bce1d2332c27

	/// Rendement piloté par la sélection P_Periode (fenêtres glissantes = dernier cours <= date cible ; calendaires = premier cours >= début de période) : réplique utils.py
	measure 'Rendement Période' =
			VAR TypeP = SELECTEDVALUE(P_Periode[Type], "glissante")
			VAR NbJours = SELECTEDVALUE(P_Periode[Jours], 30)
			VAR Cle = SELECTEDVALUE(P_Periode[Cle], "1M")
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			VAR DernierPrix = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR DebutCalendaire =
			    SWITCH(Cle,
			        "WTD", LastD - WEEKDAY(LastD, 3),
			        "MTD", DATE(YEAR(LastD), MONTH(LastD), 1),
			        "QTD", DATE(YEAR(LastD), QUOTIENT(MONTH(LastD) - 1, 3) * 3 + 1, 1),
			        "STD", DATE(YEAR(LastD), IF(MONTH(LastD) <= 6, 1, 7), 1),
			        "YTD", DATE(YEAR(LastD), 1, 1),
			        "OTD", DATE(1900, 1, 1),
			        BLANK())
			VAR PrixBase =
			    IF(TypeP = "glissante",
			        CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] <= LastD - NbJours),
			        CALCULATE(FIRSTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] >= DebutCalendaire))
			RETURN DIVIDE(DernierPrix, PrixBase) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Actions\Rendements
		lineageTag: 0d5745bb-a15e-47e5-ad14-25fb6aef5d85

	measure 'Perf WTD' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			VAR Debut = LastD - WEEKDAY(LastD, 3)
			VAR DernierPrix = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR PrixBase = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] >= Debut)
			RETURN DIVIDE(DernierPrix, PrixBase) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Actions\Perf calendaires
		lineageTag: b0059846-7e70-472b-a606-8b940590d15e

	measure 'Perf MTD' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			VAR Debut = DATE(YEAR(LastD), MONTH(LastD), 1)
			VAR DernierPrix = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR PrixBase = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] >= Debut)
			RETURN DIVIDE(DernierPrix, PrixBase) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Actions\Perf calendaires
		lineageTag: 25c5b898-968c-4bd6-9b95-fc5c35bfc697

	measure 'Perf QTD' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			VAR Debut = DATE(YEAR(LastD), QUOTIENT(MONTH(LastD) - 1, 3) * 3 + 1, 1)
			VAR DernierPrix = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR PrixBase = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] >= Debut)
			RETURN DIVIDE(DernierPrix, PrixBase) - 1
