			VAR PrixBase = CALCULATE(LASTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] <= LastD - 1095)
