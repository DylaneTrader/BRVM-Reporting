	/// Cours normalisé à 100 sur la première séance de la période visible
	measure 'Base 100' =
			VAR PremierPrix = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Actions[Date], AVERAGE(Cotations_Actions[Cloture])), ALLSELECTED(Dim_Date))
			RETURN DIVIDE([Cours Clôture], PremierPrix) * 100
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 0b25c7fe-645c-4882-9e44-782ac5b4f000

	/// Écart au plus haut atteint depuis le début de la période visible
	measure 'Drawdown %' =
			VAR DateCourante = MAX(Dim_Date[Date])
			VAR MaxCourant = CALCULATE(MAX(Cotations_Actions[Cloture]), FILTER(ALLSELECTED(Dim_Date[Date]), Dim_Date[Date] <= DateCourante))
			RETURN DIVIDE([Cours Clôture], MaxCourant) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Actions
		lineageTag: 98e8e505-e7df-453d-8481-15688608de2f

	/// Écart-type des rendements quotidiens × racine(252) : réplique utils.py
	measure 'Volatilité Annualisée' =
			VAR EcartType = STDEV.S(Cotations_Actions[VariationPct])
			RETURN DIVIDE(EcartType, 100) * SQRT(252)
		formatString: 0.00%
		displayFolder: Actions
		lineageTag: 02fb26c0-65fd-4044-b6fd-3ad9dd176044

	measure Capitalisation = SUMX(VALUES(Dim_Action[Symbol]), CALCULATE(MAX(Dim_Action[NombreTitres]) * [Dernier Cours]))
		formatString: #,0
		displayFolder: Actions
		lineageTag: 022c1247-072f-4629-b1f8-ae89705bea56

	measure 'Capitalisation (Mrd FCFA)' = DIVIDE([Capitalisation], 1000000000)
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 897b1278-9f16-4de7-9ede-8e887c2755f0

	measure 'Rendement Dividende' = DIVIDE(SELECTEDVALUE(Dim_Action[Dividende]), [Dernier Cours])
		formatString: 0.00%
		displayFolder: Actions
		lineageTag: 3b613cec-0d88-4791-93b8-7c4584af951d

	measure 'Niveau Indice' = AVERAGE(Cotations_Indices[Cloture])
		formatString: #,0.00
		displayFolder: Indices
		lineageTag: 9ead814c-247b-4494-8590-84ca46ec1a2d

	measure 'Dernier Niveau Indice' = CALCULATE(LASTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])))
		formatString: #,0.00
		displayFolder: Indices
		lineageTag: c8b74acf-02a4-4d68-b673-a850f5f5168b

	measure 'Base 100 Indice' =
			VAR PremierNiveau = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), ALLSELECTED(Dim_Date))
			RETURN DIVIDE([Niveau Indice], PremierNiveau) * 100
		formatString: #,0.00
		displayFolder: Indices
		lineageTag: 33dc3b8c-4c5b-4d31-b9a7-6611ed8be06b

	measure 'Drawdown % Indice' =
			VAR DateCourante = MAX(Dim_Date[Date])
			VAR MaxCourant = CALCULATE(MAX(Cotations_Indices[Cloture]), FILTER(ALLSELECTED(Dim_Date[Date]), Dim_Date[Date] <= DateCourante))
			RETURN DIVIDE([Niveau Indice], MaxCourant) - 1
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Indices
		lineageTag: 82cc4f4a-ba36-4038-9d43-adb8dee8a6d6

	measure 'Volatilité Annualisée Indice' =
			VAR EcartType = STDEV.S(Cotations_Indices[VariationPct])
			RETURN DIVIDE(EcartType, 100) * SQRT(252)
		formatString: 0.00%
		displayFolder: Indices
		lineageTag: c0228d0f-9c59-4eb9-af84-68897d04be15

	measure 'Perf YTD Indice' =
			VAR LastD = CALCULATE(MAX(Cotations_Indices[Date]), REMOVEFILTERS(Dim_Date))
			VAR Debut = DATE(YEAR(LastD), 1, 1)
			VAR DernierNiveau = CALCULATE(LASTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR NiveauBase = CALCULATE(FIRSTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Indices[Date] >= Debut)
			RETURN DIVIDE(DernierNiveau, NiveauBase) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Indices
		lineageTag: 29e914d8-a95f-4c18-9ddf-67c48697b41a

	measure 'Rendement Période Indice' =
			VAR TypeP = SELECTEDVALUE(P_Periode[Type], "glissante")
			VAR NbJours = SELECTEDVALUE(P_Periode[Jours], 30)
			VAR Cle = SELECTEDVALUE(P_Periode[Cle], "1M")
			VAR LastD = CALCULATE(MAX(Cotations_Indices[Date]), REMOVEFILTERS(Dim_Date))
			VAR DernierNiveau = CALCULATE(LASTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), REMOVEFILTERS(Dim_Date))
			VAR DebutCalendaire =
			    SWITCH(Cle,
			        "WTD", LastD - WEEKDAY(LastD, 3),
			        "MTD", DATE(YEAR(LastD), MONTH(LastD), 1),
			        "QTD", DATE(YEAR(LastD), QUOTIENT(MONTH(LastD) - 1, 3) * 3 + 1, 1),
			        "STD", DATE(YEAR(LastD), IF(MONTH(LastD) <= 6, 1, 7), 1),
			        "YTD", DATE(YEAR(LastD), 1, 1),
			        "OTD", DATE(1900, 1, 1),
			        BLANK())
			VAR NiveauBase =
			    IF(TypeP = "glissante",
			        CALCULATE(LASTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Indices[Date] <= LastD - NbJours),
			        CALCULATE(FIRSTNONBLANKVALUE(Cotations_Indices[Date], AVERAGE(Cotations_Indices[Cloture])), REMOVEFILTERS(Dim_Date), Cotations_Indices[Date] >= DebutCalendaire))
			RETURN DIVIDE(DernierNiveau, NiveauBase) - 1
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Indices
		lineageTag: 4e69df1c-6428-4cca-86ea-4ac96dffce86

	measure 'BRVM Composite' = CALCULATE([Dernier Niveau Indice], REMOVEFILTERS(Dim_Indice), Dim_Indice[Symbol] = "BRVMC")
		formatString: #,0.00
		displayFolder: Bandeau marché
		lineageTag: e9224c6c-c8ce-4744-9d16-bcd51c969e49

	measure 'BRVM Composite Var Jour' =
			VAR LastD = CALCULATE(MAX(Cotations_Indices[Date]), REMOVEFILTERS(Dim_Date), REMOVEFILTERS(Dim_Indice), Dim_Indice[Symbol] = "BRVMC")
			RETURN DIVIDE(CALCULATE(AVERAGE(Cotations_Indices[VariationPct]), REMOVEFILTERS(Dim_Date), REMOVEFILTERS(Dim_Indice), Dim_Indice[Symbol] = "BRVMC", Cotations_Indices[Date] = LastD), 100)
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Bandeau marché
		lineageTag: e2fa736f-c115-4830-9a6d-90b9c882ddc5

	measure 'BRVM Composite YTD' = CALCULATE([Perf YTD Indice], REMOVEFILTERS(Dim_Indice), Dim_Indice[Symbol] = "BRVMC")
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: Bandeau marché
		lineageTag: d35ac640-ad80-4737-8261-150333bdc0a8

	/// Volume total échangé (FCFA) lors de la dernière séance : respecte les filtres Secteur/Action
	measure 'Volume FCFA Dernière Séance' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			RETURN CALCULATE(SUM(Cotations_Actions[VolumeFCFA]), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] = LastD)
		formatString: #,0
		displayFolder: Marché
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a501

	measure 'Volume Titres Dernière Séance' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			RETURN CALCULATE(SUM(Cotations_Actions[VolumeTitres]), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] = LastD)
		formatString: #,0
		displayFolder: Marché
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a502

	measure 'Volume FCFA Dernière Séance (M)' = DIVIDE([Volume FCFA Dernière Séance], 1000000)
		formatString: #,0.0
		displayFolder: Marché
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a503

	measure 'Séances Médianes par Action' = MEDIANX(VALUES(Cotations_Actions[Symbol]), CALCULATE(COUNTROWS(Cotations_Actions)))
		formatString: #,0
		displayFolder: Marché
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a504

	measure 'Nb Séances' = COUNTROWS(Cotations_Actions)
		formatString: #,0
		displayFolder: Actions
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a505

	measure 'Cours Min' = MIN(Cotations_Actions[Cloture])
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a506

	measure 'Cours Max' = MAX(Cotations_Actions[Cloture])
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a507

	/// Plus haut cours de clôture sur les 365 derniers jours calendaires
	measure 'Plus Haut 1 An' =
			VAR LastD = CALCULATE(MAX(Cotations_Actions[Date]), REMOVEFILTERS(Dim_Date))
			RETURN CALCULATE(MAX(Cotations_Actions[Cloture]), REMOVEFILTERS(Dim_Date), Cotations_Actions[Date] > LastD - 365)
		formatString: #,0.00
		displayFolder: Actions
		lineageTag: 3f6a1c2e-9b4d-4e8a-b7c5-a1d2e3f4a508

	measure 'KYC Valorisation (MFCFA)' = SELECTEDVALUE(Dim_Action[ValorisationMFCFA])
		formatString: #,0
